# --- Browser-exposed (must be prefixed NEXT_PUBLIC_) ---

# Read-path / query API base. Leave as /api to use the Next.js rewrite proxy.
NEXT_PUBLIC_API_BASE_URL=/api

# WebSocket URL for the push-notification channel. Rewrites do NOT proxy WS,
# so this must point straight at the backend.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Server-only ---

# Where the /api/* rewrite forwards to in dev.
API_PROXY_TARGET=http://localhost:8080
